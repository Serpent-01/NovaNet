# AI Bridge listen address
AI_BRIDGE_HOST=127.0.0.1
AI_BRIDGE_PORT=18080

# Upstream real AI endpoint.
# Example:
#   OpenAI:   https://api.openai.com/v1/chat/completions
#   DeepSeek: https://api.deepseek.com/chat/completions
#   Qwen-compatible endpoint: fill your provider URL here
AI_BRIDGE_UPSTREAM_URL=https://api.deepseek.com/chat/completions

# API key of your real AI provider
AI_BRIDGE_API_KEY=
# Model name
AI_BRIDGE_MODEL=deepseek-chat

# Timeout
AI_BRIDGE_CONNECT_TIMEOUT_SECONDS=3
AI_BRIDGE_READ_TIMEOUT_SECONDS=60

# Max request body guard
AI_BRIDGE_MAX_MESSAGES=64
AI_BRIDGE_MAX_CONTENT_CHARS=20000